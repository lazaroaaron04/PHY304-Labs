Cell["Problem 3", "Text",
 CellChangeTimes->{{4.002363522289213*^9, 
  4.002363524143641*^9}},ExpressionUUID->"068fd8b2-542a-484e-b5a4-\
f61c544e2470"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"\[IndentingNewLine]", 
  RowBox[{
   RowBox[{"Clear", "[", "f", "]"}], "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{"w", "[", "x_", "]"}], ":=", 
    RowBox[{
     RowBox[{"f", "[", "x", "]"}], " ", 
     RowBox[{"g", "[", "x", "]"}], " ", 
     RowBox[{"h", "[", "x", "]"}]}]}], "\n", 
   RowBox[{"D", "[", 
    RowBox[{
     RowBox[{"w", "[", "x", "]"}], ",", "x"}], "]"}], "\n"}]}]], "Input",
 CellChangeTimes->{{4.002363423847837*^9, 4.0023634241260967`*^9}},
 CellLabel->"In[58]:=",ExpressionUUID->"c379ac97-2ffc-47fb-8308-e494a0055894"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"g", "[", "x", "]"}], " ", 
   RowBox[{"h", "[", "x", "]"}], " ", 
   RowBox[{
    SuperscriptBox["f", "\[Prime]",
     MultilineFunction->None], "[", "x", "]"}]}], "+", 
  RowBox[{
   RowBox[{"f", "[", "x", "]"}], " ", 
   RowBox[{"h", "[", "x", "]"}], " ", 
   RowBox[{
    SuperscriptBox["g", "\[Prime]",
     MultilineFunction->None], "[", "x", "]"}]}], "+", 
  RowBox[{
   RowBox[{"f", "[", "x", "]"}], " ", 
   RowBox[{"g", "[", "x", "]"}], " ", 
   RowBox[{
    SuperscriptBox["h", "\[Prime]",
     MultilineFunction->None], "[", "x", "]"}]}]}]], "Output",
 CellChangeTimes->{4.002363425158575*^9},
 CellLabel->"Out[60]=",ExpressionUUID->"39894388-8189-427b-84f8-b4726e63ff72"]
}, Open  ]],

Cell["Problem 4", "Text",
 CellChangeTimes->{{4.002363529155147*^9, 
  4.0023635312983427`*^9}},ExpressionUUID->"12bfa75f-40d1-4155-81c5-\
af7946606749"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"\[IndentingNewLine]", 
  RowBox[{
   RowBox[{"Clear", "[", 
    RowBox[{"t", ",", "\[Phi]"}], "]"}], "\n", 
   RowBox[{
    RowBox[{"g", "=", "9.81"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"l", "=", "10"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"\[Omega]", "=", 
     RowBox[{"Sqrt", "[", 
      RowBox[{"g", "/", "l"}], "]"}]}], ";"}], "\[IndentingNewLine]", "\n", 
   RowBox[{"sol", "=", 
    RowBox[{"NDSolve", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{"\[Phi]", "''"}], "[", "t", "]"}], "==", 
         RowBox[{
          RowBox[{"-", 
           RowBox[{"\[Omega]", "^", "2"}]}], " ", 
          RowBox[{"Sin", "[", 
           RowBox[{"\[Phi]", "[", "t", "]"}], "]"}]}]}], ",", 
        RowBox[{
         RowBox[{
          RowBox[{"\[Phi]", "'"}], "[", "0", "]"}], "==", "0"}], ",", 
        RowBox[{
         RowBox[{"\[Phi]", "[", "0", "]"}], "==", 
         RowBox[{"30", " ", "Degree"}]}]}], "}"}], ",", "\[Phi]", ",", 
      RowBox[{"{", 
       RowBox[{"t", ",", "0", ",", "10"}], "}"}]}], "]"}]}], "\n", 
   RowBox[{"Plot", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"\[Phi]", "[", "x", "]"}], "/.", " ", "sol"}], ",", 
     RowBox[{"{", 
      RowBox[{"x", ",", "0", ",", "10"}], "}"}]}], "]"}]}]}]], "Input",
 CellChangeTimes->{{4.0023634285912457`*^9, 4.00236342982734*^9}},
 CellLabel->"In[61]:=",ExpressionUUID->"483b9e43-656c-4c43-bcd2-e7d3fff1ea05"],

