Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"\[IndentingNewLine]", 
  RowBox[{
   RowBox[{"D", "[", 
    RowBox[{
     RowBox[{"f", "[", "t", "]"}], ",", "t"}], "]"}], "\n", 
   RowBox[{"D", "[", 
    RowBox[{
     RowBox[{"f", "[", "t", "]"}], ",", 
     RowBox[{"{", 
      RowBox[{"t", ",", "2"}], "}"}]}], "]"}], "\n", 
   RowBox[{
    RowBox[{"f", "[", "t_", "]"}], ":=", 
    RowBox[{"\[Alpha]", " ", 
     RowBox[{"Log", "[", 
      RowBox[{"a", " ", "t"}], "]"}], " ", 
     RowBox[{"Cos", "[", 
      RowBox[{"\[Omega]", " ", "t"}], "]"}], " ", 
     RowBox[{"Sin", "[", 
      RowBox[{"\[Omega]", " ", "t"}], "]"}]}]}]}]}]], "Input",
 CellChangeTimes->{{4.002363418290436*^9, 4.00236341883195*^9}},
 CellLabel->"In[55]:=",ExpressionUUID->"78746000-5447-423f-a2d4-8c20d8d21259"],

Cell[BoxData[
 RowBox[{
  SuperscriptBox["f", "\[Prime]",
   MultilineFunction->None], "[", "t", "]"}]], "Output",
 CellChangeTimes->{4.002363419761546*^9},
 CellLabel->"Out[55]=",ExpressionUUID->"dc8e3099-347e-469b-a437-b8e44e9d1642"],

Cell[BoxData[
 RowBox[{
  SuperscriptBox["f", "\[Prime]\[Prime]",
   MultilineFunction->None], "[", "t", "]"}]], "Output",
