Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"Clear", "[", 
   RowBox[{"x", ",", "sol"}], "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"m", "=", "10"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"k", "=", "20"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"b", "=", "1"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"x0", "=", "5"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"v0", "=", "0"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"wd", "=", "5"}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"F0", "=", "10"}], ";"}], "\[IndentingNewLine]"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"sol", "=", 
    RowBox[{"NDSolve", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{"x", "''"}], "[", "t", "]"}], "+", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{"b", "/", "m"}], ")"}], " ", 
           RowBox[{
            RowBox[{"x", "'"}], "[", "t", "]"}]}], "+", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{"k", "/", "m"}], ")"}], " ", 
           RowBox[{"x", "[", "t", "]"}]}]}], "==", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{"F0", "/", "m"}], ")"}], " ", 
          RowBox[{"Cos", "[", 
           RowBox[{"wd", " ", "t"}], "]"}]}]}], ",", 
        RowBox[{
         RowBox[{"x", "[", "0", "]"}], "==", "x0"}], ",", 
        RowBox[{
         RowBox[{
          RowBox[{"x", "'"}], "[", "0", "]"}], "==", "v0"}]}], "}"}], ",", 
      "x", ",", 
      RowBox[{"{", 
       RowBox[{"t", ",", "0", ",", "100"}], "}"}]}], "]"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\n", 
 RowBox[{"Plot", "[", 
  RowBox[{
   RowBox[{"Evaluate", "[", 
    RowBox[{
     RowBox[{"x", "[", "t", "]"}], "/.", " ", "sol"}], "]"}], ",", 
   RowBox[{"{", 
    RowBox[{"t", ",", "0", ",", "100"}], "}"}], ",", 
   RowBox[{"PlotLabel", "->", "\"\<Driven Damped Oscillator\>\""}], ",", 
   RowBox[{"AxesLabel", "->", 
    RowBox[{"{", 
     RowBox[{"\"\<Time (s)\>\"", ",", "\"\<Position (m)\>\""}], "}"}]}], ",", 
   
   RowBox[{"PlotRange", "->", "All"}], ",", 
   RowBox[{"Epilog", "->", 
    RowBox[{"{", 
     RowBox[{"Red", ",", "Dashed", ",", 
      RowBox[{"InfiniteLine", "[", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"60", ",", "0"}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"60", ",", "1"}], "}"}]}], "}"}], "]"}]}], "}"}]}]}], 
  "]"}]}], "Input",
 CellChangeTimes->{{4.00236281276607*^9, 4.002362813667938*^9}},
 CellLabel->"In[25]:=",ExpressionUUID->"1db1ad04-7799-4bf7-853c-36eab5719b79"],

