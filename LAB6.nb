Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"Clear", "[", 
   RowBox[{"x", ",", "sol"}], "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"m", "=", "10"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"k", "=", "20"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"b", "=", "0"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"F0", "=", "10"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"wd", "=", "1.3"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"x0", "=", "0"}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"v0", "=", "0"}], ";"}], "\[IndentingNewLine]"}], "\n", 
 RowBox[{
  RowBox[{"sol", "=", 
   RowBox[{"NDSolve", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{"x", "''"}], "[", "t", "]"}], "+", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{"b", "/", "m"}], ")"}], " ", 
          RowBox[{
           RowBox[{"x", "'"}], "[", "t", "]"}]}], "+", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{"k", "/", "m"}], ")"}], " ", 
          RowBox[{"x", "[", "t", "]"}]}]}], "==", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{"F0", "/", "m"}], ")"}], " ", 
         RowBox[{"Cos", "[", 
          RowBox[{"wd", " ", "t"}], "]"}]}]}], ",", 
       RowBox[{
        RowBox[{"x", "[", "0", "]"}], "==", "x0"}], ",", 
       RowBox[{
        RowBox[{
         RowBox[{"x", "'"}], "[", "0", "]"}], "==", "v0"}]}], "}"}], ",", "x",
      ",", 
     RowBox[{"{", 
      RowBox[{"t", ",", "0", ",", "100"}], "}"}]}], "]"}]}], 
  "\[IndentingNewLine]"}], "\n", 
 RowBox[{"Plot", "[", 
  RowBox[{
   RowBox[{"Evaluate", "[", 
    RowBox[{
     RowBox[{"x", "[", "t", "]"}], "/.", " ", "sol"}], "]"}], ",", 
   RowBox[{"{", 
    RowBox[{"t", ",", "0", ",", "100"}], "}"}], ",", 
   RowBox[{"PlotLabel", "->", "\"\<Driven Undamped Oscillator\>\""}], ",", 
   RowBox[{"AxesLabel", "->", 
    RowBox[{"{", 
     RowBox[{"\"\<Time (s)\>\"", ",", "\"\<Position (m)\>\""}], "}"}]}], ",", 
   
   RowBox[{"PlotRange", "->", "All"}]}], "]"}]}], "Input",
 CellChangeTimes->{{4.002362839218199*^9, 4.002362840104257*^9}},
 CellLabel->"In[44]:=",ExpressionUUID->"e8919e02-686c-4247-abb9-c8bd6e7af0b5"],

