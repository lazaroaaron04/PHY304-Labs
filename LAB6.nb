Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"Clear", "[", 
   RowBox[{"x", ",", "sol"}], "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"m", "=", "10"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"k", "=", "20"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"b", "=", "1"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"F0", "=", "10"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"x0", "=", "0"}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"v0", "=", "0"}], ";"}], "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"sol", "=", 
   RowBox[{"NDSolve", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{"x", "''"}], "[", "t", "]"}], "+", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{"b", "/", "m"}], ")"}], " ", 
          RowBox[{
           RowBox[{"x", "'"}], "[", "t", "]"}]}], "+", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{"k", "/", "m"}], ")"}], " ", 
          RowBox[{"x", "[", "t", "]"}]}]}], "==", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{"F0", "/", "m"}], ")"}], " ", 
         RowBox[{"Cos", "[", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{"0.5", "+", 
             RowBox[{"0.01", "*", "t"}]}], ")"}], "*", "t"}], "]"}]}]}], ",", 
       
       RowBox[{
        RowBox[{"x", "[", "0", "]"}], "==", "x0"}], ",", 
       RowBox[{
        RowBox[{
         RowBox[{"x", "'"}], "[", "0", "]"}], "==", "v0"}]}], "}"}], ",", "x",
      ",", 
     RowBox[{"{", 
      RowBox[{"t", ",", "0", ",", "100"}], "}"}]}], "]"}]}], "\n"}], "\[IndentingNewLine]", 
 RowBox[{"Plot", "[", 
  RowBox[{
   RowBox[{"Evaluate", "[", 
    RowBox[{
     RowBox[{"x", "[", "t", "]"}], "/.", " ", "sol"}], "]"}], ",", 
   RowBox[{"{", 
    RowBox[{"t", ",", "0", ",", "100"}], "}"}], ",", 
   RowBox[{
   "PlotLabel", 
    "->", "\"\<Driven Damped Oscillator with Varying Frequency\>\""}], ",", 
   RowBox[{"AxesLabel", "->", 
    RowBox[{"{", 
     RowBox[{"\"\<Time (s)\>\"", ",", "\"\<Position (m)\>\""}], "}"}]}], ",", 
   
   RowBox[{"PlotRange", "->", "All"}]}], "]"}]}], "Input",
 CellChangeTimes->{{4.0023628332146883`*^9, 4.002362833214818*^9}},
 CellLabel->"In[35]:=",ExpressionUUID->"ce2cae16-80c1-4fdd-8955-ede03dc4639c"],

