Cell["\<\
The damping parameters are below the critical threshold (\[Gamma] < \
2\[Omega]0). This causes the system to oscillate with an amplitude that \
decreases over time.\
\>", "Text",
 CellChangeTimes->{
  4.00236290721067*^9},ExpressionUUID->"7df6545f-65e3-496f-b309-cda5952dbc1b"],

Cell[BoxData[""], "Input",
 CellChangeTimes->{{4.0023629151439877`*^9, 
  4.002362915837549*^9}},ExpressionUUID->"7e9f8fb8-460b-42d8-aa69-\
a2e25114d61e"],

Cell[BoxData[""], "Input",
 CellChangeTimes->{{4.002362881580597*^9, 
  4.00236290278791*^9}},ExpressionUUID->"24ddc68d-6a89-48fe-9c29-\
542ac06c0efd"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"Clear", "[", "x", "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"m", "=", "10"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"k", "=", "20"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"b", "=", "80"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"x0", "=", "5"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"v0", "=", "0"}], ";"}], "\n", 
 RowBox[{"sol", "=", 
  RowBox[{"NDSolve", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"x", "''"}], "[", "t", "]"}], "+", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{"b", "/", "m"}], ")"}], " ", 
         RowBox[{
          RowBox[{"x", "'"}], "[", "t", "]"}]}], "+", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{"k", "/", "m"}], ")"}], " ", 
         RowBox[{"x", "[", "t", "]"}]}]}], "==", "0"}], ",", 
      RowBox[{
       RowBox[{"x", "[", "0", "]"}], "==", "x0"}], ",", 
      RowBox[{
       RowBox[{
        RowBox[{"x", "'"}], "[", "0", "]"}], "==", "v0"}]}], "}"}], ",", "x", 
    ",", 
    RowBox[{"{", 
     RowBox[{"t", ",", "0", ",", "100"}], "}"}]}], "]"}]}], "\n", 
 RowBox[{"Plot", "[", 
  RowBox[{
   RowBox[{"Evaluate", "[", 
    RowBox[{
     RowBox[{"x", "[", "t", "]"}], "/.", " ", "sol"}], "]"}], ",", 
   RowBox[{"{", 
    RowBox[{"t", ",", "0", ",", "100"}], "}"}], ",", 
   RowBox[{"PlotLabel", "->", "\"\<OverDamped Harmonic Oscillator\>\""}], ",", 
   RowBox[{"AxesLabel", "->", 
    RowBox[{"{", 
     RowBox[{"\"\<Time (s)\>\"", ",", "\"\<Position (m)\>\""}], "}"}]}], ",", 
   
   RowBox[{"PlotRange", "->", "All"}]}], "]"}]}], "Input",
 CellChangeTimes->{4.002362756872018*^9},
 CellLabel->"In[9]:=",ExpressionUUID->"fa92db5e-0d33-41b4-af04-1814a5e4bb14"],

