Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"Angles", "=", 
   RowBox[{"Range", "[", 
    RowBox[{"10", ",", "85", ",", "15"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"Solutions", "=", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"NDSolveValue", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{"\[Phi]", "''"}], "[", "t", "]"}], "==", 
          RowBox[{
           RowBox[{"-", 
            RowBox[{"\[Omega]", "^", "2"}]}], " ", 
           RowBox[{"Sin", "[", 
            RowBox[{"\[Phi]", "[", "t", "]"}], "]"}]}]}], ",", 
         RowBox[{
          RowBox[{
           RowBox[{"\[Phi]", "'"}], "[", "0", "]"}], "==", "0"}], ",", 
         RowBox[{
          RowBox[{"\[Phi]", "[", "0", "]"}], "==", 
          RowBox[{"angle", " ", "Degree"}]}]}], "}"}], ",", "\[Phi]", ",", 
       RowBox[{"{", 
        RowBox[{"t", ",", "0", ",", "10"}], "}"}]}], "]"}], ",", 
     RowBox[{"{", 
      RowBox[{"angle", ",", "Angles"}], "}"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"smallAngleApprox", "=", 
   RowBox[{"2", " ", 
    RowBox[{"Pi", "/", "\[Omega]"}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"quarterPeriods", "=", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"t", "/.", " ", 
      RowBox[{"FindRoot", "[", 
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{"Solutions", "[", 
           RowBox[{"[", "i", "]"}], "]"}], "[", "t", "]"}], "==", "0"}], ",", 
        
        RowBox[{"{", 
         RowBox[{"t", ",", "0", ",", 
          RowBox[{"3", "/", "\[Omega]"}]}], "}"}]}], "]"}]}], ",", 
     RowBox[{"{", 
      RowBox[{"i", ",", 
       RowBox[{"Length", "[", "Angles", "]"}]}], "}"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"simulatedPeriods", "=", 
   RowBox[{"4", " ", "quarterPeriods"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"periodErrorPercent", "=", 
   RowBox[{"100", " ", 
    RowBox[{"Abs", "[", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"simulatedPeriods", "-", "smallAngleApprox"}], ")"}], "/", 
      "smallAngleApprox"}], "]"}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"firstAtTenPercent", "=", 
   RowBox[{"First", "@", 
    RowBox[{"Select", "[", 
     RowBox[{
      RowBox[{"Transpose", "[", 
       RowBox[{"{", 
        RowBox[{"Angles", ",", "periodErrorPercent"}], "}"}], "]"}], ",", 
      RowBox[{
       RowBox[{
        RowBox[{"Last", "[", "#", "]"}], ">=", "10"}], "&"}]}], "]"}]}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{"thresholdAngle", "=", 
   RowBox[{
    RowBox[{"180", "/", "Pi"}], " ", 
    RowBox[{"(", 
     RowBox[{"\[Theta]", "/.", " ", 
      RowBox[{"FindRoot", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"2", " ", 
          RowBox[{
           RowBox[{"EllipticK", "[", 
            RowBox[{
             RowBox[{"Sin", "[", 
              RowBox[{"\[Theta]", "/", "2"}], "]"}], "^", "2"}], "]"}], "/", 
           "Pi"}]}], "==", "1.1"}], ",", 
        RowBox[{"{", 
         RowBox[{"\[Theta]", ",", "1.2"}], "}"}]}], "]"}]}], ")"}]}]}], 
  ";"}], "\n", 
 RowBox[{"ListLinePlot", "[", 
  RowBox[{
   RowBox[{"Transpose", "[", 
    RowBox[{"{", 
     RowBox[{"Angles", ",", "periodErrorPercent"}], "}"}], "]"}], ",", 
   RowBox[{"PlotMarkers", "->", "Automatic"}], ",", 
   RowBox[{"PlotRange", "->", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"0", ",", "90"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"0", ",", "All"}], "}"}]}], "}"}]}], ",", 
   RowBox[{"AxesLabel", "->", 
    RowBox[{"{", 
     RowBox[{"\"\<Initial angle (deg)\>\"", ",", "\"\<Period error (%)\>\""}],
      "}"}]}], ",", 
   RowBox[{
   "PlotLabel", "->", "\"\<Small-angle period error vs. initial angle\>\""}], 
   ",", 
   RowBox[{"GridLines", "->", "Automatic"}], ",", 
   RowBox[{"Epilog", "->", 
    RowBox[{"{", 
     RowBox[{"Red", ",", "Dashed", ",", 
      RowBox[{"Line", "[", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"0", ",", "10"}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"80", ",", "10"}], "}"}]}], "}"}], "]"}]}], "}"}]}]}], 
  "]"}]}], "Input",
 CellChangeTimes->{4.0029859131221027`*^9},
