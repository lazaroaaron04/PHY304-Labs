Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{"Clear", "[", 
  RowBox[{
  "g", ",", "l", ",", "\[Omega]", ",", "\[Phi]", ",", "t", ",", "a", ",", 
   "s"}], "]"}], "\n", 
 RowBox[{
  RowBox[{"g", "=", "9.81"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"l", "=", "10"}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"\[Omega]", "=", 
    RowBox[{"Sqrt", "[", 
     RowBox[{"g", "/", "l"}], "]"}]}], ";"}], "\[IndentingNewLine]"}], "\n", 
 RowBox[{
  RowBox[{"angles", "=", 
   RowBox[{"{", 
    RowBox[{"10", ",", "20", ",", "45", ",", "70", ",", "90"}], "}"}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{"s", "=", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"NDSolveValue", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{"\[Phi]", "''"}], "[", "t", "]"}], "==", 
          RowBox[{
           RowBox[{"-", 
            RowBox[{"\[Omega]", "^", "2"}]}], " ", 
           RowBox[{"Sin", "[", 
            RowBox[{"\[Phi]", "[", "t", "]"}], "]"}]}]}], ",", 
         RowBox[{
          RowBox[{
           RowBox[{"\[Phi]", "'"}], "[", "0", "]"}], "==", "0"}], ",", 
         RowBox[{
          RowBox[{"\[Phi]", "[", "0", "]"}], "==", 
          RowBox[{"a", " ", "Degree"}]}]}], "}"}], ",", "\[Phi]", ",", 
       RowBox[{"{", 
        RowBox[{"t", ",", "0", ",", "10"}], "}"}]}], "]"}], ",", 
     RowBox[{"{", 
      RowBox[{"a", ",", "angles"}], "}"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{"Plot", "[", 
  RowBox[{
   RowBox[{"Evaluate", "@", 
    RowBox[{"Table", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"s", "[", 
        RowBox[{"[", "i", "]"}], "]"}], "[", "t", "]"}], ",", 
      RowBox[{"{", 
       RowBox[{"i", ",", 
        RowBox[{"Length", "[", "angles", "]"}]}], "}"}]}], "]"}]}], ",", 
   RowBox[{"{", 
    RowBox[{"t", ",", "0", ",", "10"}], "}"}], ",", 
   RowBox[{"PlotLegends", "->", 
    RowBox[{"Placed", "[", 
     RowBox[{
      RowBox[{"LineLegend", "[", 
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{"Style", "[", 
           RowBox[{"#", ",", "12"}], "]"}], "&"}], "/@", "angles"}], ",", 
        RowBox[{"LegendLabel", "->", "\"\<Initial angle (deg)\>\""}]}], "]"}],
       ",", "Right"}], "]"}]}], ",", 
   RowBox[{"AxesLabel", "->", 
    RowBox[{"{", 
     RowBox[{"\"\<t\>\"", ",", "\"\<\[Phi](t)\>\""}], "}"}]}], ",", 
   RowBox[{"PlotRange", "->", "All"}], ",", 
   RowBox[{"GridLines", "->", "Automatic"}]}], "]"}]}], "Input",
