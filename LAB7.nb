Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"g", "=", "9.81"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"l", "=", "10"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"\[Omega]", "=", 
   RowBox[{"Sqrt", "[", 
    RowBox[{"g", "/", "l"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"angle", "=", 
    RowBox[{"30", " ", "Degree"}]}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"sol", "=", 
    RowBox[{"NDSolve", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{"\[Phi]", "''"}], "[", "t", "]"}], "==", 
         RowBox[{
          RowBox[{"-", 
           RowBox[{"\[Omega]", "^", "2"}]}], " ", 
          RowBox[{"Sin", "[", 
           RowBox[{"\[Phi]", "[", "t", "]"}], "]"}]}]}], ",", 
        RowBox[{
         RowBox[{
          RowBox[{"\[Phi]", "'"}], "[", "0", "]"}], "==", "0"}], ",", 
        RowBox[{
         RowBox[{"\[Phi]", "[", "0", "]"}], "==", "angle"}]}], "}"}], ",", 
      "\[Phi]", ",", 
      RowBox[{"{", 
       RowBox[{"t", ",", "0", ",", "20"}], "}"}]}], "]"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"analytical", "[", "t_", "]"}], ":=", 
    RowBox[{"angle", " ", 
     RowBox[{"Cos", "[", 
      RowBox[{"\[Omega]", " ", "t"}], "]"}]}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{"Plot", "[", 
  RowBox[{
   RowBox[{"Evaluate", "[", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{
       RowBox[{"\[Phi]", "[", "t", "]"}], "/.", " ", 
       RowBox[{"First", "[", "sol", "]"}]}], ",", 
      RowBox[{"analytical", "[", "t", "]"}]}], "}"}], "]"}], ",", 
   RowBox[{"{", 
    RowBox[{"t", ",", "0", ",", "20"}], "}"}], ",", 
   RowBox[{"PlotLegends", "->", 
    RowBox[{"{", 
     RowBox[{"\"\<Simulation\>\"", ",", "\"\<Analytical\>\""}], "}"}]}], ",", 
   
   RowBox[{"AxesLabel", "->", 
    RowBox[{"{", 
     RowBox[{"\"\<Time (s)\>\"", ",", "\"\<Angle (rad)\>\""}], "}"}]}], ",", 
   RowBox[{"PlotLabel", "->", "\"\<Numerical vs Analytical Pendulum\>\""}]}], 
  "]"}], "\n"}], "Input",
 CellChangeTimes->{{4.002364103652692*^9, 4.002364166018935*^9}, {
   4.0023641970567093`*^9, 4.0023643685235653`*^9}, {4.0023644048246117`*^9, 
