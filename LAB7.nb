Notebook[{
Cell["From Lab 5: Nonlinear pendulum", "Text",
 CellChangeTimes->{{4.0023640867309103`*^9, 
  4.002364097947298*^9}},ExpressionUUID->"e9ab530f-0d74-4ea2-a2ff-\
019f29f88f44"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"g", " ", "=", " ", "9.81"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"l", " ", "=", " ", "10"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"\[Omega]", " ", "=", " ", 
    RowBox[{"Sqrt", "[", 
     RowBox[{"g", "/", "l"}], "]"}]}], ";"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{"sol", "=", 
  RowBox[{"NDSolve", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{"\[Phi]", "''"}], "[", "t", "]"}], "==", 
       RowBox[{
        RowBox[{"-", 
         RowBox[{"\[Omega]", "^", "2"}]}], " ", 
        RowBox[{"Sin", "[", 
         RowBox[{"\[Phi]", "[", "t", "]"}], "]"}]}]}], ",", 
      RowBox[{
       RowBox[{
        RowBox[{"\[Phi]", "'"}], "[", "0", "]"}], "==", "0"}], ",", 
      RowBox[{
       RowBox[{"\[Phi]", "[", "0", "]"}], "==", 
       RowBox[{"30", " ", "Degree"}]}]}], "}"}], ",", "\[Phi]", ",", 
    RowBox[{"{", 
     RowBox[{"t", ",", "0", ",", "10"}], "}"}]}], "]"}]}], "\n", 
 RowBox[{"Plot", "[", 
  RowBox[{
   RowBox[{
    RowBox[{"\[Phi]", "[", "x", "]"}], "/.", " ", "sol"}], ",", 
   RowBox[{"{", 
    RowBox[{"x", ",", "0", ",", "10"}], "}"}]}], "]"}]}], "Input",
 CellChangeTimes->{{4.002363878705941*^9, 4.0023638885178022`*^9}, {
  4.0023639600883837`*^9, 4.002364066449717*^9}},
 CellLabel->"In[1]:=",ExpressionUUID->"dcf1e335-9d25-4407-8a91-e448aa49b454"],

